[Unit]
Description=SurvAlerte — Sauvegarde quotidienne de la base de données
After=network.target

[Service]
Type=oneshot
User=david
WorkingDirectory=/home/david/survalerte
ExecStart=/usr/bin/python3 /home/david/survalerte/backup.py
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
